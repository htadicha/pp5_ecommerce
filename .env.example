# Django Settings
# SECURITY WARNING: Generate a new SECRET_KEY for production using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='your-secret-key-here-generate-a-strong-one'
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1

# Database (PostgreSQL)
# For Heroku: This is automatically provided by Heroku Postgres addon
# For local development: Use your local database URL
DATABASE_URL=postgres://user:password@host:port/database

# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY='your_stripe_publishable_key_here'
STRIPE_SECRET_KEY='your_stripe_secret_key_here'

# AWS S3 Configuration (Optional - for static/media files in production)
# Uncomment and configure these if you want to use AWS S3
# USE_AWS=True
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_S3_REGION_NAME=us-east-1

# Email Configuration (Optional - for sending emails)
# Uncomment and configure for production email sending
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_email_app_password
